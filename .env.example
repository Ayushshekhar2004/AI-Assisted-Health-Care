# Values are available from the Supabase project's Connect dialog.
# The publishable key is intended for clients and remains protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SUPABASE_PROJECT_REF=local
NEXT_PUBLIC_RESOURCE_NAMESPACE=development-local
APP_ENV=development

# Never add a Supabase secret/service-role key to a NEXT_PUBLIC_ variable.
# Server deployments performing admin verification require SUPABASE_SECRET_KEY
# from the deployment secret manager. Never commit its value.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Server-only salt used to pseudonymize rate-limit keys. Required in production; generate at least
# 32 random characters and store it in the deployment secret manager. Rotation clears counters.
RATE_LIMIT_SALT=replace_with_at_least_32_random_characters

# Server-only salt for irreversible monitoring pseudonyms. Use a distinct random value of at least
# 32 characters. Never expose it through NEXT_PUBLIC_ or reuse another salt.
MONITORING_HASH_SALT=replace_with_a_distinct_32_character_random_value

# Retention jobs default to dry-run. Set true only in a trusted scheduled-job environment after the
# policy version and launch-blocking legal decisions have been approved.
DATA_RETENTION_EXECUTION_ENABLED=false

# Server-only text AI provider. OpenAI remains the default. Ollama is restricted to local
# development/test use and is never called from browser code.
AI_PROVIDER=openai

# OpenAI configuration. Choose models available to your project that support Structured Outputs.
# Never expose the API key through NEXT_PUBLIC_. Voice transcription remains OpenAI-only.
OPENAI_API_KEY=sk_replace_me
OPENAI_INTAKE_MODEL=replace_with_structured_outputs_model
OPENAI_ROUTING_MODEL=replace_with_structured_outputs_model
OPENAI_CONSULTATION_MODEL=replace_with_structured_outputs_model
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe

# Local Ollama configuration used when AI_PROVIDER=ollama. OLLAMA_BASE_URL must use loopback or an
# explicit RFC1918 private-LAN IP. Choose an installed model with structured-output support.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=replace_with_local_model

# Server-only notification delivery provider. The development provider records successful no-op
# delivery and is rejected in production. It never logs message content or recipient data.
NOTIFICATION_PROVIDER=development

# LiveKit credentials are server-only. LIVEKIT_URL is returned only after appointment authorization.
# Never expose LIVEKIT_API_SECRET through a NEXT_PUBLIC_ variable.
LIVEKIT_URL=wss://replace-with-your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret
# Never commit credentials or patient/doctor data.
