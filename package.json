  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "audit:dependencies": "npm audit --audit-level=high",
    "eval:offline": "vitest run src/modules/evaluation/offline-evaluation.test.ts",
    "seed:demo": "node scripts/seed-demo.mjs",
